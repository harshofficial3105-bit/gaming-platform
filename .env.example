# ==============================================================================
# ARCADEHUB ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. Base Application Domain (Temporary Cloudflare URL or Localhost)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Supabase PostgreSQL & Auth (Safe for Browser)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-public-anon-key>

# 3. Supabase Service Role Key (SERVER-SIDE SECRET ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=<your-secret-service-role-key>

# 4. Cloudflare R2 Object Storage (Server-Side Game Bundle Uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=arcadehub-games
NEXT_PUBLIC_R2_PUBLIC_URL=